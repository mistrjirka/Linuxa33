# Experimental local package for Samsung Galaxy A33 5G.
# Generate modules-initfs only with scripts/generate-modules-initfs.py in its
# default guarded mode. Do not copy all of TWRP's modules.load.recovery: that
# configuration caused a repeatable panic in phy_exynos_mipi.

pkgname=device-samsung-a33x
pkgdesc="Samsung Galaxy A33 5G"
pkgver=3
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"

depends="
	linux-samsung-a33x
	postmarketos-base
"
makedepends="devicepkg-dev"

source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	90-samsung-a33x-unsafe-modules.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	install -Dm644 "$srcdir/90-samsung-a33x-unsafe-modules.conf" \
		"$pkgdir/etc/modprobe.d/90-samsung-a33x-unsafe-modules.conf"
}

sha512sums=""
