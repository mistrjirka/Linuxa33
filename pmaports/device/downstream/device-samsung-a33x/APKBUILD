# Experimental local package for Samsung Galaxy A33 5G.
# Generate modules-initfs only with scripts/generate-modules-initfs.py in its
# default guarded mode. Do not copy all of TWRP's modules.load.recovery: that
# configuration caused a repeatable panic in phy_exynos_mipi.

pkgname=device-samsung-a33x
pkgdesc="Samsung Galaxy A33 5G"
pkgver=3
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"

# The A33 USB-C data path was proven by U0g. Keep the working path as device
# dependencies so a fresh `pmbootstrap install` cannot silently omit it:
#
# - watchdog continuity during early bring-up;
# - explicit USB-PD activation while intentionally bypassing the unsafe full
#   MUIC/CPIF/BTS soft-dependency closure;
# - dynamic discovery of the I2C adapter backed by physical controller
#   13860000.hsi2c, followed by the verified S2MU106 MUIC 0x17/0x24 sequence;
# - temporary metadata persistence for the next normal-rootfs handoff test;
# - debug-shell payload retained as a rescue facility, inactive unless the
#   pmos.debug-shell kernel parameter is explicitly supplied.
depends="
	linux-samsung-a33x
	postmarketos-base
	postmarketos-mkinitfs-hook-debug-shell
	postmarketos-mkinitfs-hook-a33x-watchdog
	postmarketos-mkinitfs-hook-a33x-usbpd
	postmarketos-mkinitfs-hook-a33x-muic-switch-dynamic
	postmarketos-mkinitfs-hook-a33x-muic-persist-dynamic
"
makedepends="devicepkg-dev"

source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	90-samsung-a33x-unsafe-modules.conf
"

build() {
	devicepkg_build "$startdir" "$pkgname"
}

package() {
	devicepkg_package "$startdir" "$pkgname"

	install -Dm644 "$srcdir/90-samsung-a33x-unsafe-modules.conf" \
		"$pkgdir/etc/modprobe.d/90-samsung-a33x-unsafe-modules.conf"
}

sha512sums=""
