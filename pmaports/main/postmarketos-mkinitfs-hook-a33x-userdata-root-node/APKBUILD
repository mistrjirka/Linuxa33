pkgname=postmarketos-mkinitfs-hook-a33x-userdata-root-node
pkgver=1
pkgrel=0
pkgdesc="Create the verified A33 userdata root block node in the initramfs"
url="https://github.com/mistrjirka/Linuxa33"
arch="noarch"
license="MIT"
depends="postmarketos-mkinitfs"
options="!check"
