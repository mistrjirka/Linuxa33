builddir="$srcdir"

package() {
	install -Dm755 "$srcdir/05-a33x-userdata-root-node.sh" \
		"$pkgdir/usr/share/mkinitfs/hooks/05-a33x-userdata-root-node.sh"
}

sha512sums=""
